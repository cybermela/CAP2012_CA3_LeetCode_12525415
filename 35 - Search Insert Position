
#include <iostream>
using namespace std;

int main()
{
    int nums[] = {1, 3, 5, 6};
    int target = 2;

    int n = 4;
    int low = 0;
    int high = n - 1;
    int mid;

    while (low <= high)
    {
        mid = (low + high) / 2;

        if (nums[mid] == target)
        {
            cout << "Index: " << mid;
            return 0;
        }
        else if (nums[mid] < target)
        {
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }

    cout << "Insert at index: " << low;

    return 0;
}
