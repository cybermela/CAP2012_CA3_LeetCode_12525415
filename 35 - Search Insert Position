
#include <iostream>
using namespace std;

int searchInsert(int numbers[], int size, int searchValue)
{
    int startIndex = 0;
    int endIndex = size - 1;

    while (startIndex <= endIndex)
    {
        int middleIndex = (startIndex + endIndex) / 2;

        if (numbers[middleIndex] == searchValue)
            return middleIndex;

        else if (numbers[middleIndex] < searchValue)
            startIndex = middleIndex + 1;

        else
            endIndex = middleIndex - 1;
    }

    return startIndex;
}

int main()
{
    int firstArray[] = {1, 3, 5, 6};
    int secondArray[] = {1, 3, 5, 6};
    int thirdArray[] = {1, 3, 5, 6};

    cout << "Example 1: Target = 5" << endl;
    cout << "Output: "
         << searchInsert(firstArray, 4, 5) << endl;

    cout << "-------------------" << endl;

    cout << "Example 2: Target = 2" << endl;
    cout << "Output: "
         << searchInsert(secondArray, 4, 2) << endl;

    cout << "-------------------" << endl;

    cout << "Example 3: Target = 7" << endl;
    cout << "Output: "
         << searchInsert(thirdArray, 4, 7) << endl;

    return 0;
}
