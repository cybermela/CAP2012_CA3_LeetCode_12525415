
#include <iostream>
using namespace std;

int countSteps(int number)
{
    int stepCounter = 0;

    while (number != 0)
    {
        if (number % 2 == 0)
            number = number / 2;
        else
            number = number - 1;

        stepCounter++;
    }

    return stepCounter;
}

int main()
{
    int testNumbers[] = {14, 8, 123};

    for (int i = 0; i < 3; i++)
    {
        cout << "Input: " << testNumbers[i] << endl;
        cout << "Output: " << countSteps(testNumbers[i]) << endl;
        cout << "-------------------" << endl;
    }

    return 0;
}
