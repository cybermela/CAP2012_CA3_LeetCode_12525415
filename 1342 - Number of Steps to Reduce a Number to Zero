
#include <iostream>
using namespace std;

int main()
{
    int num;
    int steps = 0;

    cout << "Enter a number: ";
    cin >> num;

    while (num != 0)
    {
        if (num % 2 == 0)
        {
            num = num / 2;
        }
        else
        {
            num = num - 1;
        }

        steps++;
    }

    cout << "Number of steps: " << steps;

    return 0;
}
