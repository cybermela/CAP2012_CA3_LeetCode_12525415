
#include <iostream>
using namespace std;

class MyCircularDeque
{
private:
    int* elements;
    int capacity;
    int frontIndex;
    int count;

public:

    MyCircularDeque(int k)
    {
        capacity = k;
        elements = new int[k];
        frontIndex = 0;
        count = 0;
    }

    bool insertFront(int value)
    {
        if (isFull())
            return false;

        frontIndex = (frontIndex - 1 + capacity) % capacity;

        elements[frontIndex] = value;
        count++;

        return true;
    }

    bool insertLast(int value)
    {
        if (isFull())
            return false;

        int rearIndex = (frontIndex + count) % capacity;

        elements[rearIndex] = value;
        count++;

        return true;
    }

    bool deleteFront()
    {
        if (isEmpty())
            return false;

        frontIndex = (frontIndex + 1) % capacity;
        count--;

        return true;
    }

    bool deleteLast()
    {
        if (isEmpty())
            return false;

        count--;

        return true;
    }

    int getFront()
    {
        if (isEmpty())
            return -1;

        return elements[frontIndex];
    }

    int getRear()
    {
        if (isEmpty())
            return -1;

        int rearIndex = (frontIndex + count - 1) % capacity;

        return elements[rearIndex];
    }

    bool isEmpty()
    {
        return count == 0;
    }

    bool isFull()
    {
        return count == capacity;
    }

    ~MyCircularDeque()
    {
        delete[] elements;
    }
};

int main()
{
    MyCircularDeque myDeque(3);

    cout << "Insert Last 1: "
         << myDeque.insertLast(1) << endl;

    cout << "Insert Last 2: "
         << myDeque.insertLast(2) << endl;

    cout << "Insert Front 3: "
         << myDeque.insertFront(3) << endl;

    cout << "Insert Front 4: "
         << myDeque.insertFront(4) << endl;

    cout << "Get Rear: "
         << myDeque.getRear() << endl;

    cout << "Is Full: "
         << myDeque.isFull() << endl;

    cout << "Delete Last: "
         << myDeque.deleteLast() << endl;

    cout << "Insert Front 4: "
         << myDeque.insertFront(4) << endl;

    cout << "Get Front: "
         << myDeque.getFront() << endl;

    return 0;
}
