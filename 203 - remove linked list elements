
#include <iostream>
using namespace std;

struct Node
{
    int data;
    Node* next;
};

Node* removeElements(Node* head, int val)
{
    Node* dummy = new Node{0, head};
    Node* current = dummy;

    while (current->next != NULL)
    {
        if (current->next->data == val)
        {
            Node* temp = current->next;
            current->next = current->next->next;
            delete temp;
        }
        else
        {
            current = current->next;
        }
    }

    Node* newHead = dummy->next;
    delete dummy;

    return newHead;
}

void displayList(Node* head)
{
    cout << "[";

    while (head != NULL)
    {
        cout << head->data;

        head = head->next;

        if (head != NULL)
            cout << ",";
    }

    cout << "]" << endl;
}

void testCase(int values[], int size, int val)
{
    Node* head = NULL;
    Node* tail = NULL;

    for (int i = 0; i < size; i++)
    {
        Node* newNode = new Node{values[i], NULL};

        if (head == NULL)
            head = newNode;
        else
            tail->next = newNode;

        tail = newNode;
    }

    cout << "Input: ";
    displayList(head);

    cout << "Value to remove: " << val << endl;

    head = removeElements(head, val);

    cout << "Output: ";
    displayList(head);

    cout << "-------------------" << endl;

    while (head != NULL)
    {
        Node* temp = head;
        head = head->next;
        delete temp;
    }
}

int main()
{
    int arr1[] = {1, 2, 6, 3, 4, 5, 6};
    int arr2[] = {};
    int arr3[] = {7, 7, 7, 7};

    testCase(arr1, 7, 6);
    testCase(arr2, 0, 1);
    testCase(arr3, 4, 7);

    return 0;
}
