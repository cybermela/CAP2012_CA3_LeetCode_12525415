
#include <iostream>
using namespace std;

void moveZeroes(int numbers[], int size)
{
    int insertPosition = 0;

    for (int currentIndex = 0; currentIndex < size; currentIndex++)
    {
        if (numbers[currentIndex] != 0)
        {
            int temporaryValue = numbers[currentIndex];

            numbers[currentIndex] = numbers[insertPosition];
            numbers[insertPosition] = temporaryValue;

            insertPosition++;
        }
    }
}

void displayArray(int numbers[], int size)
{
    cout << "[";

    for (int i = 0; i < size; i++)
    {
        cout << numbers[i];

        if (i < size - 1)
            cout << ", ";
    }

    cout << "]" << endl;
}

int main()
{
    int firstArray[] = {0, 1, 0, 3, 12};
    int secondArray[] = {0};

    cout << "Example 1" << endl;
    cout << "Input: ";
    displayArray(firstArray, 5);

    moveZeroes(firstArray, 5);

    cout << "Output: ";
    displayArray(firstArray, 5);

    cout << "-------------------" << endl;

    cout << "Example 2" << endl;
    cout << "Input: ";
    displayArray(secondArray, 1);

    moveZeroes(secondArray, 1);

    cout << "Output: ";
    displayArray(secondArray, 1);

    return 0;
}
