
#include <iostream>
#include <vector>
#include <climits>
using namespace std;

double findMedianSortedArrays(vector<int>& firstArray, vector<int>& secondArray)
{
    if (firstArray.size() > secondArray.size())
        return findMedianSortedArrays(secondArray, firstArray);

    int m = firstArray.size();
    int n = secondArray.size();

    int low = 0;
    int high = m;

    while (low <= high)
    {
        int cutA = (low + high) / 2;
        int cutB = (m + n + 1) / 2 - cutA;

        int leftA = (cutA == 0) ? INT_MIN : firstArray[cutA - 1];
        int rightA = (cutA == m) ? INT_MAX : firstArray[cutA];

        int leftB = (cutB == 0) ? INT_MIN : secondArray[cutB - 1];
        int rightB = (cutB == n) ? INT_MAX : secondArray[cutB];

        if (leftA <= rightB && leftB <= rightA)
        {
            if ((m + n) % 2 == 0)
            {
                return (max(leftA, leftB) + (double)min(rightA, rightB)) / 2;
            }
            else
            {
                return max(leftA, leftB);
            }
        }
        else if (leftA > rightB)
        {
            high = cutA - 1;
        }
        else
        {
            low = cutA + 1;
        }
    }

    return 0.0;
}

void testCase(vector<int> firstArray, vector<int> secondArray)
{
    cout << "Array 1: [";

    for (int i = 0; i < firstArray.size(); i++)
    {
        cout << firstArray[i];
        if (i < firstArray.size() - 1) cout << ",";
    }

    cout << "]" << endl;

    cout << "Array 2: [";

    for (int i = 0; i < secondArray.size(); i++)
    {
        cout << secondArray[i];
        if (i < secondArray.size() - 1) cout << ",";
    }

    cout << "]" << endl;

    cout << "Median: "
         << findMedianSortedArrays(firstArray, secondArray)
         << endl;

    cout << "-------------------" << endl;
}

int main()
{
    vector<int> arr1 = {1, 3};
    vector<int> arr2 = {2};

    vector<int> arr3 = {1, 2};
    vector<int> arr4 = {3, 4};

    cout << "Example 1" << endl;
    testCase(arr1, arr2);

    cout << "Example 2" << endl;
    testCase(arr3, arr4);

    return 0;
}
