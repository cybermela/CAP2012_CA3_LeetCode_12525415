
#include <iostream>
using namespace std;

int binarySearch(int numbers[], int size, int searchValue)
{
    int startIndex = 0;
    int endIndex = size - 1;

    while (startIndex <= endIndex)
    {
        int middleIndex = (startIndex + endIndex) / 2;

        if (numbers[middleIndex] == searchValue)
            return middleIndex;

        else if (numbers[middleIndex] < searchValue)
            startIndex = middleIndex + 1;

        else
            endIndex = middleIndex - 1;
    }

    return -1;
}

int main()
{
    int firstArray[] = {-1, 0, 3, 5, 9, 12};
    int secondArray[] = {-1, 0, 3, 5, 9, 12};

    cout << "Example 1" << endl;
    cout << "Target: 9" << endl;
    cout << "Output: "
         << binarySearch(firstArray, 6, 9) << endl;

    cout << "-------------------" << endl;

    cout << "Example 2" << endl;
    cout << "Target: 2" << endl;
    cout << "Output: "
         << binarySearch(secondArray, 6, 2) << endl;

    return 0;
}
