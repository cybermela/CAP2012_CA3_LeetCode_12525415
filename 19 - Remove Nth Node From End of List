
#include <iostream>
using namespace std;

struct Node
{
    int data;
    Node* next;
};

Node* removeNthFromEnd(Node* head, int n)
{
    Node dummy = {0, head};

    Node* fastRunner = &dummy;
    Node* slowRunner = &dummy;

    for (int i = 0; i <= n; i++)
    {
        fastRunner = fastRunner->next;
    }

    while (fastRunner != NULL)
    {
        fastRunner = fastRunner->next;
        slowRunner = slowRunner->next;
    }

    Node* temp = slowRunner->next;

    slowRunner->next = temp->next;

    delete temp;

    return dummy.next;
}

void displayList(Node* head)
{
    cout << "[";

    while (head != NULL)
    {
        cout << head->data;

        head = head->next;

        if (head != NULL)
            cout << ",";
    }

    cout << "]" << endl;
}

void testCase(int values[], int size, int n)
{
    Node* head = NULL;
    Node* tail = NULL;

    for (int i = 0; i < size; i++)
    {
        Node* newNode = new Node{values[i], NULL};

        if (head == NULL)
            head = newNode;
        else
            tail->next = newNode;

        tail = newNode;
    }

    cout << "Input: ";
    displayList(head);

    cout << "Remove nth node from end: " << n << endl;

    head = removeNthFromEnd(head, n);

    cout << "Output: ";
    displayList(head);

    cout << "-------------------" << endl;

    while (head != NULL)
    {
        Node* temp = head;
        head = head->next;
        delete temp;
    }
}

int main()
{
    int arr1[] = {1, 2, 3, 4, 5};
    int arr2[] = {1};
    int arr3[] = {1, 2};

    testCase(arr1, 5, 2);
    testCase(arr2, 1, 1);
    testCase(arr3, 2, 1);

    return 0;
}
